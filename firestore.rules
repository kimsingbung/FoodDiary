rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여넣고 "게시"하세요.
// members() 에 있는 구글 계정만 데이터를 읽고 쓸 수 있습니다. (js/config.js 의 MEMBERS 와 같은 사람)
// 실제 이메일이 들어간 규칙은 private/firestore.rules 에 따로 보관합니다 (GitHub에 올라가지 않음).
service cloud.firestore {
  match /databases/{database}/documents {

    function members() {
      return {
        'me@gmail.com': 'a',       // ← 내 구글 이메일 (소문자)
        'friend@gmail.com': 'b'    // ← 같이 쓸 사람 구글 이메일 (소문자)
      };
    }

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in members();
    }

    function me() {
      return members()[request.auth.token.email];
    }

    // 가게(지도 핀): 두 사람 모두 추가/수정/삭제 가능
    match /places/{placeId} {
      allow read, write: if allowed();
    }

    // 방문 기록: 두 사람 모두 수정 가능, 단 후기(reviews)는 본인 것만
    match /visits/{visitId} {
      allow read, delete: if allowed();
      allow create: if allowed()
        && request.resource.data.get('reviews', {}).keys().hasOnly([me()]);
      allow update: if allowed()
        && request.resource.data.get('reviews', {})
             .diff(resource.data.get('reviews', {})).affectedKeys().hasOnly([me()]);
    }

    // 원본 사진
    match /photos/{photoId} {
      allow read, create, delete: if allowed();
    }
  }
}
